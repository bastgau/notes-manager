# Copy to .env (never commit it) and fill in the values.

# Image version to run, without the leading "v" (see the GitHub releases).
NOTES_MANAGER_VERSION=1.0.0

# Bearer token required by every MCP request. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Git repository holding the notes, and the branch to mirror.
NOTES_REPO_URL=git@github.com:OWNER/NOTES_REPO.git
NOTES_BRANCH=main

# Seconds between two git fetches (0 disables the periodic sync).
NOTES_SYNC_INTERVAL=60

# Host paths and numeric user of the container (see README).
NOTES_DATA_DIR=./data/notes
NOTES_DEPLOY_KEY=./deploy_key
NOTES_UID=1000
NOTES_GID=1000

# Write tools (write_doc, rename_tag). Disabled by default.
# When enabled, changes are pushed to inbox/* branches, never to the main branch.
NOTES_WRITE=false
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
